<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 360" width="100%" height="100%">
  <!-- Definitions for arrows -->
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 1 L 10 5 L 0 9 z" fill="#4b5563" />
    </marker>
  </defs>

  <!-- Background -->
  <rect width="800" height="360" rx="15" fill="#0f172a" />

  <!-- Title -->
  <text x="400" y="35" fill="#f8fafc" font-size="18" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">Agentic RAG Project Flow</text>

  <!-- --- ingestion track (top) --- -->
  
  <!-- PDF Icon -->
  <g transform="translate(60, 70)">
    <rect width="70" height="70" rx="8" fill="#fca5a5" stroke="#ef4444" stroke-width="2"/>
    <!-- PDF Text/Icon -->
    <path d="M 25 20 L 45 20 L 45 50 L 25 50 Z" fill="none" stroke="#ef4444" stroke-width="2"/>
    <text x="35" y="40" fill="#7f1d1d" font-size="11" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">PDF</text>
    <text x="35" y="90" fill="#cbd5e1" font-size="12" font-family="system-ui, sans-serif" text-anchor="middle">story.pdf</text>
  </g>

  <!-- Arrow 1 -->
  <line x1="140" y1="105" x2="200" y2="105" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" />

  <!-- PyPDFLoader -->
  <g transform="translate(210, 70)">
    <rect width="130" height="70" rx="8" fill="#fde047" stroke="#eab308" stroke-width="2"/>
    <text x="65" y="32" fill="#713f12" font-size="13" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">PyPDFLoader</text>
    <text x="65" y="50" fill="#713f12" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Loads &amp; Splits PDF</text>
  </g>

  <!-- Arrow 2 -->
  <line x1="350" y1="105" x2="400" y2="105" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" />

  <!-- Embeddings -->
  <g transform="translate(410, 70)">
    <rect width="150" height="70" rx="8" fill="#d8b4fe" stroke="#a855f7" stroke-width="2"/>
    <text x="75" y="32" fill="#581c87" font-size="13" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">Gemini Embeddings</text>
    <text x="75" y="50" fill="#581c87" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">text-embedding-001</text>
  </g>

  <!-- Arrow 3 -->
  <line x1="570" y1="105" x2="620" y2="105" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" />

  <!-- Pinecone DB -->
  <g transform="translate(630, 65)">
    <!-- Cylinder representation for database -->
    <path d="M0,15 A40,15 0 0,0 80,15 A40,15 0 0,0 0,15 L0,65 A40,15 0 0,0 80,65 L80,15 Z" fill="#86efac" stroke="#22c55e" stroke-width="2"/>
    <ellipse cx="40" cy="15" rx="40" ry="15" fill="#86efac" stroke="#22c55e" stroke-width="2"/>
    <text x="40" y="45" fill="#14532d" font-size="13" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">Pinecone</text>
    <text x="40" y="60" fill="#14532d" font-size="10" font-family="system-ui, sans-serif" text-anchor="middle">py-index</text>
  </g>


  <!-- --- query track (bottom) --- -->

  <!-- User Icon -->
  <g transform="translate(60, 220)">
    <circle cx="35" cy="20" r="12" fill="#93c5fd" stroke="#3b82f6" stroke-width="2"/>
    <path d="M 15 50 A 20 20 0 0 1 55 50 Z" fill="#93c5fd" stroke="#3b82f6" stroke-width="2"/>
    <text x="35" y="75" fill="#cbd5e1" font-size="12" font-family="system-ui, sans-serif" text-anchor="middle">User / Client</text>
  </g>

  <!-- Arrow User -> Agent -->
  <line x1="140" y1="245" x2="200" y2="245" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow)" />
  <text x="170" y="235" fill="#60a5fa" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Query</text>

  <!-- LangChain Agent -->
  <g transform="translate(210, 210)">
    <rect width="130" height="70" rx="8" fill="#93c5fd" stroke="#3b82f6" stroke-width="2"/>
    <text x="65" y="32" fill="#1e3a8a" font-size="13" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">LangChain Agent</text>
    <text x="65" y="50" fill="#1e3a8a" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">gemini-3.5-flash</text>
  </g>

  <!-- Arrow Agent -> Tool -->
  <line x1="350" y1="245" x2="400" y2="245" stroke="#f97316" stroke-width="2" marker-end="url(#arrow)" />
  <text x="375" y="235" fill="#fdb574" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Call</text>

  <!-- getContext Tool -->
  <g transform="translate(410, 210)">
    <rect width="150" height="70" rx="8" fill="#fed7aa" stroke="#f97316" stroke-width="2"/>
    <text x="75" y="32" fill="#7c2d12" font-size="13" font-family="system-ui, sans-serif" font-weight="bold" text-anchor="middle">getContext Tool</text>
    <text x="75" y="50" fill="#7c2d12" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Similarity Search</text>
  </g>

  <!-- Tool -> Pinecone Search Arrow -->
  <path d="M 560 235 L 670 235 L 670 155" fill="none" stroke="#22c55e" stroke-width="2" marker-end="url(#arrow)" />
  <text x="615" y="225" fill="#4ade80" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Similarity Search</text>

  <!-- Pinecone -> Tool Context Arrow -->
  <path d="M 650 155 L 650 255 L 565 255" fill="none" stroke="#22c55e" stroke-width="2" marker-end="url(#arrow)" />
  <text x="610" y="270" fill="#4ade80" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Context</text>

  <!-- Tool -> Agent (Return Context) -->
  <path d="M 410 260 L 350 260" fill="none" stroke="#f97316" stroke-width="2" marker-end="url(#arrow)" />

  <!-- Agent -> User (Response) -->
  <path d="M 210 260 L 145 260" fill="none" stroke="#3b82f6" stroke-width="2" marker-end="url(#arrow)" />
  <text x="175" y="275" fill="#60a5fa" font-size="11" font-family="system-ui, sans-serif" text-anchor="middle">Answer</text>

</svg>
